<head>
    <meta charset="UTF-8">
    <title>Bloco <%= blockNumber %></title>
</head>
<body onload="iniciaPagina()">
    <div id="topBar" class="topBar">
        <nav>
            <a href="/blocks">Blocks</a>
            <a href="/txs">Transactions</a>
            <a href="/logs">Logs</a>
            <a href="/chamadas">Chamadas</a>
            <a href="/LICENSE">License</a>
        </nav>
    </div>

    <div id="searchBar" class="searchBar">
        <br>
        <input type="text" placeholder="Procurar.." id="barraDePesquisa">
        <button onclick="paginaBloco()">Ver</button>
        <br>
    </div>
    
    <div id="dadosPrincipais" class="dadosPrincipais">
        <h1>Bloco <%= blockNumber %></h1>

        <div id="tableDiv", class="tableDiv">
            <table>
            <tr>
                <th>Atributo</th>
                <th>Valor</th>
            </tr>
            <tr>
                <td>hash</td>
                <td id="hash"></td>
            </tr>
            <tr>
                <td>baseFeePerGas</td>
                <td id="baseFeePerGas"></td>
            </tr>
            <tr>
                <td>blobGasUsed</td>
                <td id="blobGasUsed"></td>
            </tr>
            <tr>
                <td>difficulty</td>
                <td id="difficulty"></td>
            </tr>
            <tr>
                <td>excessBlobGas</td>
                <td id="excessBlobGas"></td>
            </tr>
            <tr>
                <td>extraData</td>
                <td id="extraData"></td>
            </tr>
            <tr>
                <td>gasLimit</td>
                <td id="gasLimit"></td>
            </tr>
            <tr>
                <td>gasUsed</td>
                <td id="gasUsed"></td>
            </tr>
            <tr>
                <td>logsBloom</td>
                <td id="logsBloom"></td>
            </tr>
            <tr>
                <td>miner</td>
                <td id="miner"></td>
            </tr>
            <tr>
                <td>mixHash</td>
                <td id="mixHash"></td>
            </tr>
            <tr>
                <td>nonce</td>
                <td id="nonce"></td>
            </tr>
            <tr>
                <td>number</td>
                <td id="number"></td>
            </tr>
            <tr>
                <td>parentBeaconBlockRoot</td>
                <td id="parentBeaconBlockRoot"></td>
            </tr>
            <tr>
                <td>parentHash</td>
                <td id="parentHash"></td>
            </tr>
            <tr>
                <td>receiptsRoot</td>
                <td id="receiptsRoot"></td>
            </tr>
            <tr>
                <td>requestsHash</td>
                <td id="requestsHash"></td>
            </tr>
            <tr>
                <td>sha3Uncles</td>
                <td id="sha3Uncles"></td>
            </tr>
            <tr>
                <td>size</td>
                <td id="size"></td>
            </tr>
            <tr>
                <td>stateRoot</td>
                <td id="stateRoot"></td>
            </tr>
            <tr>
                <td>timestamp</td>
                <td id="timestamp"></td>
            </tr>
            </table>
        </div>
    </div>

    <hr>

    <div id="transacoes" class="transacoes">
        <h2 id="titulo-transacoes"></h2>

        <div id="campo-transacoes">

        </div>

    </div>

    <hr>

    <div id="uncles" class="uncles">
        <h2 id="titulo-uncles"></h2>

        <div id="campo-uncles">

        </div>
    </div>

    <hr>

    <div id="saques" class="saques">
        <h2 id="titulo-saques"></h2>

        <div id="campo-saques">

        </div>
    </div>

    <script>
        let blockNumberTemp = "<%= blockNumber %>";
        let blockNumber;
        
        async function iniciaPagina() {
            let elemento;
            let response;
            
            if (blockNumberTemp[0] != "0" && blockNumberTemp[1] != "x") {
                blockNumber = "0x" + BigInt(blockNumberTemp).toString(16);
                response = await enviar("eth_getBlockByNumber", `["${blockNumber}",false]`);
            } else {
                blockNumber = blockNumberTemp;
                response = await enviar("eth_getBlockByHash", `["${blockNumber}",false]`);
            }
            
            console.log("-> ", response);

            const atributos = ["hash", "baseFeePerGas", "blobGasUsed", "difficulty", "excessBlobGas", "extraData", "gasLimit", "gasUsed", "logsBloom", "miner", "mixHash", "nonce","number", "parentBeaconBlockRoot","parentHash","receiptsRoot","requestsHash","sha3Uncles","size","stateRoot","timestamp"];

            for (id in atributos) {
                console.log(atributos[id]);
                await populaElemento(atributos[id], response);
            }

            const tituloTx = document.getElementById(`titulo-transacoes`);
            tituloTx.innerHTML = `Tx: ${response.result["transactions"].length}`;

            for (id in response.result["transactions"]) {
                console.log(id);
                const campoTx = document.getElementById("campo-transacoes");
                const tx = document.createElement("p");
                tx.innerHTML = `<p><a href="/tx/${response.result["transactions"][id]}">${response.result["transactions"][id]}</a></p>`

                campoTx.appendChild(tx);
            }

            const tituloUncles = document.getElementById(`titulo-uncles`);
            tituloUncles.innerHTML = `Uncles: ${response.result["uncles"].length}`;

            for (id in response.result["uncles"]) {
                console.log(id);
                const campoUncles = document.getElementById("campo-uncles");
                const Uncle = document.createElement("p");
                Uncle.innerHTML = `<p><a href="/tx/${response.result["uncles"][id]}">${response.result["uncles"][id]}</a></p>`

                campoTx.appendChild(tx);
            }

            const tituloSaques = document.getElementById(`titulo-saques`);
            tituloSaques.innerHTML = `Saques: ${response.result["withdrawals"].length}`;

            for (id in response.result["withdrawals"]) {
                console.log(id);
                const campoSaques = document.getElementById("campo-saques");
                const Saque = document.createElement("p");
                Saque.innerHTML = `<p><a href="/tx/${response.result["withdrawals"][id]}">${response.result["withdrawals"][id]}</a></p>`

                campoTx.appendChild(tx);
            }
        }

        async function populaElemento(id, response) {
            console.log("-> ", `"${id}"`, response.result[`${id}`]);
            const element = document.getElementById(`${id}`);
            element.innerHTML = response.result[`${id}`];
        }
            
            
        async function enviar(metodo, params) {
            console.log("Sending request to RPC node:", metodo, params);

            const response = await fetch("/api", {
                method: "POST",
                headers: {
                "Content-Type": "application/json",
                },
                body: `{"method": "${metodo}","params": ${params},"id": 1,"jsonrpc": "2.0"}`,
            });
            const data = await response.json();
            
            return data;
        }

        function paginaBloco() {
            let bloco = document.getElementById("barraDePesquisa").value;
            console.log(bloco);

            window.open(`http://127.0.0.1:3000/block/${bloco}`)
        }
    </script>

</body>