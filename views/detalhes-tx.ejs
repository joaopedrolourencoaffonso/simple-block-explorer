<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>Tx: #<%= txHash %></title>
    </head>
    <body onload="iniciaPagina()">
        <div id="topBar" class="topBar">
            <nav>
                <a href="/blocks">Blocks</a>
                <a href="/txs">Transactions</a>
                <a href="/logs">Logs</a>
                <a href="/chamadas">Chamadas</a>
                <a href="/LICENSE">License</a>
            </nav>
        </div>

        <div id="searchBar" class="searchBar">
            <br>
            <input type="text" placeholder="Procurar.." id="barraDePesquisaBloco">
            <button onclick="paginaBloco()">Ver Bloco</button>
            <br>
            <br>
            <input type="text" placeholder="Procurar.." id="barraDePesquisaTx">
            <button onclick="paginaTx()">Ver Tx</button>
            <br>
        </div>

        <h2>Tx: #<%= txHash %></h2>

        <div id="detalhesTx", class="detalhesTx">
            
        </div>

        <script src="/js/basic_functions.js"></script>
        <script>
            async function iniciaPagina() {
                const response = await enviar("eth_getTransactionByHash", `["<%= txHash %>"]`);
                const tx = response.result;

                for (const [key, value] of Object.entries(tx)) {
                    console.log(`${key}:`, value);

                    const linhaDetalhe = document.createElement("div");

                    linhaDetalhe.innerHTML = `<p>${key}: ${value}</p>`;

                    const detalhesTx = document.getElementById("detalhesTx");
                    detalhesTx.appendChild(linhaDetalhe);
                }
            }
        </script>
    </body>
</html>