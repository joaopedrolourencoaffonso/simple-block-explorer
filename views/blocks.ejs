<!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>Blocos</title>
        <link rel="stylesheet" href="/css/style.css">
    </head>
    <body class="blocks-page" onload="iniciaPagina()">
        <%- include("partials/header") %>
        <%- include("partials/searchBars") %>
        
        <main>
        <h1>Recent Blocks</h1>
        <div id="blocosRecentes" class="blocosRecentes">
            
        </div>
        </main>

        <script src="/js/basic_functions.js"></script>
        <script>
            let numeroDeBlocos;

            async function iniciaPagina() {
                let elemento;
                let response;

                // blockNumber
                response = await enviar("eth_blockNumber", '[]');
                elemento = document.getElementById("blockNumber");
                numeroDeBlocosInicial = parseInt(response.result, 16);

                const final = numeroDeBlocosInicial - 20;
                let blockNumber = numeroDeBlocosInicial;

                console.log("Começando!")

                while (final < blockNumber) {
                    console.log(blockNumber);
                    let hex = blockNumber.toString(16);

                    const resultado = await enviar("eth_getBlockByNumber", `["0x${hex}",false]`);
                    if (resultado.error) {
                        throw new Error(resultado.error.message);
                    }

                    const bloco = resultado.result;
                    if (!bloco) {
                        throw new Error(`No block returned for ${blockNumber}`);
                    }

                    const blocosRecentes = document.getElementById("blocosRecentes");
                    const blocoDiv = document.createElement("div");
                    if (blockNumber === numeroDeBlocosInicial) {
                        blocoDiv.classList.add("newest-block");
                    }

                    const hashP = document.createElement("p");
                    hashP.innerHTML = `Hash: <a href="/block/${bloco.hash}">${bloco.hash}</a>`;

                    const numeroHoraP = document.createElement("p");
                    const hora = new Date(Number(bloco.timestamp) * 1000).toLocaleTimeString();
                    numeroHoraP.textContent = `Number: ${blockNumber} | Hour: ${hora} | Tx: ${bloco.transactions.length}`;

                    const minerP = document.createElement("p");
                    minerP.textContent = `Miner: ${bloco.miner}`;
                    minerP.innerHTML = minerP.innerHTML + "<hr>"

                    blocoDiv.appendChild(hashP);
                    blocoDiv.appendChild(numeroHoraP);
                    blocoDiv.appendChild(minerP);
                    //blocoDiv.appendChild("<hr>");

                    blocosRecentes.appendChild(blocoDiv);

                    // para a próxima iteração
                    blockNumber--;
                }
            }
        </script>
    </body>
  </html>
