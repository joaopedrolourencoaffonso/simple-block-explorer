{
  "name": "simple-block-explorer",
  "version": "1.0.0-rc.6",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "eth_blockNumber": "node src/CLI/metodos.js eth_blockNumber '[]'",
    "eth_chainId": "node src/CLI/metodos.js eth_chainId '[]'",
    "eth_baseFee": "node src/CLI/metodos.js eth_baseFee '[]'",
    "eth_gasPrice": "node src/CLI/metodos.js eth_gasPrice '[]'",
    "eth_syncing": "node src/CLI/metodos.js eth_syncing '[]'",
    "net_peerCount": "node src/CLI/metodos.js net_peerCount '[]'",
    "net_version": "node src/CLI/metodos.js net_version '[]'",
    "net_listening": "node src/CLI/metodos.js net_listening '[]'",
    "web3_clientVersion": "node src/CLI/metodos.js web3_clientVersion '[]'",
    "txpool_content": "node src/CLI/metodos.js txpool_content '[]'",
    "txpool_status": "node src/CLI/metodos.js txpool_status '[]'",
    "eth_base_fee": "node src/CLI/metodos.js eth_base_fee '[]'",
    "eth_maxPriorityFeePerGas": "node src/CLI/metodos.js eth_maxPriorityFeePerGas '[]'",
    "web3_sha3": "node src/CLI/metodos.js web3_sha3",
    "eth_getBalance": "node src/CLI/metodos.js eth_getBalance",
    "eth_getBlockByNumber": "node src/CLI/metodos.js eth_getBlockByNumber",
    "eth_getBlockByHash": "node src/CLI/metodos.js eth_getBlockByHash",
    "eth_getBlockReceipts": "node src/CLI/metodos.js eth_getBlockReceipts '[\"latest\"]'",
    "eth_getBlockTransactionCountByHash": "node src/CLI/metodos.js eth_getBlockTransactionCountByHash",
    "eth_getBlockTransactionCountByNumber": "node src/CLI/metodos.js eth_getBlockTransactionCountByNumber",
    "eth_estimateGas": "node src/CLI/eth_estimateGas.js",
    "eth_call": "node src/CLI/eth_call.js",
    "eth_getCode": "node src/CLI/eth_getCode.js",
    "eth_getTransactionByBlockHashAndIndex": "node src/CLI/eth_getTransactionByBlockHashAndIndex.js",
    "eth_getTransactionByBlockNumberAndIndex": "node src/CLI/eth_getTransactionByBlockNumberAndIndex.js",
    "eth_getTransactionByHash": "node src/CLI/eth_getTransactionByHash.js",
    "eth_getTransactionCount": "node src/CLI/eth_getTransactionCount.js",
    "eth_getTransactionReceipt": "node src/CLI/eth_getTransactionReceipt.js",
    "eth_getLogs": "node src/CLI/eth_getLogs.js"
  },
  "author": "João Pedro Lourenço Affonso",
  "license": "MIT",
  "description": "A simple blockchain explorer for Ethereum-like blockchains, built with Node.js and Express.",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  }
}